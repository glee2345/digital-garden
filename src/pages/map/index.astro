---
// The map: every thought near its topic, connections as dotted lines, drawn
// in characters. ?t=<id> lights up one thought and its neighbors;
// ?topic=<slug> lights up one topic.
import Garden from '../../layouts/Garden.astro';
import { loadGarden } from '../../lib/garden.js';
import { drawMap } from '../../lib/asciimap.js';
const g = loadGarden();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const map = g.thoughts.length ? drawMap(g) : null;
---
<Garden current="map" title="map" description="Each thought, next to what it's about.">
  <div class="view-head">
    <h1 class="lede">Each thought, next to what it's about.</h1>
    <div class="legend">
      {g.topics.map((tp) => <a href={tp.url} class="map-key" data-topic={tp.slug}><i class="swatch" style={`background:${tp.color}`} aria-hidden="true"></i>{tp.name}</a>)}
    </div>
  </div>

  {map ? (
    <div class="panel map-panel ascii" id="map" aria-label="The map: each @ is a thought, each o a photo or link, dotted lines are connections. Click a thought to open it.">
      <pre set:html={map.html} />
      <div class="hovercard" id="hover" data-open="false"><span class="k" id="hk"></span><span class="t" id="ht"></span><span class="m" id="hm"></span></div>
    </div>
  ) : (
    <div class="panel" style="padding:40px 20px;text-align:center"><p class="foot-note">Nothing planted yet.</p></div>
  )}
  <p class="foot-note"><span class="k" style="font-family:var(--mono);font-weight:700;color:var(--green-ink)">@</span> a thought, <span class="k" style="font-family:var(--mono);font-weight:700;color:var(--green-ink)">o</span> a photo or link, <span style="font-family:var(--mono)">. . .</span> a connection the garden found. Thoughts sit near their topic and drift toward the topics they also touch. Click a topic's name to follow just that one. <a href="#" id="map-clear" hidden>show everything</a></p>

  <nav class="root-list phone-list" aria-label="Topics">
    {g.topics.map((tp) => (
      <a href={tp.url}>
        <span class="n"><span style="font-size:16px"><i class="swatch" style={`background:${tp.color}`} aria-hidden="true"></i>{tp.name}</span><span>{`${tp.count} ${tp.count === 1 ? 'thought' : 'thoughts'}${tp.isNew ? ', new' : ''}`}</span></span>
      </a>
    ))}
  </nav>

  <style is:global>
    .map-panel.ascii { height: auto; overflow: auto; }
    .map-panel.ascii pre { margin: 0; padding: 20px; font-family: var(--mono); font-size: 12px; line-height: 14px; color: #6B6258; white-space: pre; min-width: max-content; }
    .map-panel.ascii pre .edge { color: #5A5146; }
    .map-panel.ascii pre .node { font-weight: 700; text-decoration: none; }
    .map-panel.ascii pre .node:hover, .map-panel.ascii pre .node:focus { text-decoration: underline; text-underline-offset: 3px; outline: none; }
    .map-panel.ascii pre .node.lit { text-shadow: 0 0 10px currentColor; text-decoration: underline; }
    .map-panel.ascii pre .node.lit-near { text-shadow: 0 0 6px currentColor; }
    .map-panel.ascii pre .edge.lit { color: var(--green-soft); }
    .map-panel.ascii[data-focus] pre .node:not(.lit):not(.lit-near) { color: #978A79 !important; }
    .map-panel.ascii[data-focus] pre .edge:not(.lit) { color: #3A332B; }
    .map-panel.ascii[data-focus] pre .map-label:not(.lit) { color: #978A79 !important; }
    .map-panel.ascii pre .map-label { font-family: var(--serif); font-style: italic; font-size: 14px; text-decoration: none; }
    .map-panel.ascii pre .map-label:hover { text-decoration: underline; text-underline-offset: 3px; }
    .map-key { color: var(--text); display: inline-flex; align-items: center; }
    .phone-list { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (max-width: 719px) { .phone-list { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: normal; display: block; } }
  </style>
  <script>
    const map = document.getElementById('map');
    if (map) {
      const hover = document.getElementById('hover');
      const clear = document.getElementById('map-clear');
      const nodes = [...map.querySelectorAll('.node')];
      const edges = [...map.querySelectorAll('.edge')];
      const labels = [...map.querySelectorAll('.map-label')];
      const unlight = () => { map.removeAttribute('data-focus'); nodes.forEach((n) => n.classList.remove('lit', 'lit-near')); edges.forEach((e) => e.classList.remove('lit')); labels.forEach((l) => l.classList.remove('lit')); clear.hidden = true; };
      const lightThought = (id) => {
        unlight();
        const me = nodes.find((n) => n.dataset.id === id); if (!me) return;
        map.dataset.focus = id; me.classList.add('lit');
        for (const e of edges) if (e.dataset.a === id || e.dataset.b === id) { e.classList.add('lit'); const o = e.dataset.a === id ? e.dataset.b : e.dataset.a; nodes.find((n) => n.dataset.id === o)?.classList.add('lit-near'); }
        clear.hidden = false; me.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' });
      };
      const lightTopic = (slug) => {
        unlight(); map.dataset.focus = slug;
        const ids = new Set(); nodes.forEach((n) => { if (n.dataset.topicSlug === slug) { n.classList.add('lit'); ids.add(n.dataset.id); } });
        edges.forEach((e) => { if (ids.has(e.dataset.a) && ids.has(e.dataset.b)) e.classList.add('lit'); });
        labels.forEach((l) => { if (l.dataset.topic === slug) l.classList.add('lit'); });
        clear.hidden = false;
      };
      nodes.forEach((n) => {
        n.addEventListener('mouseenter', () => {
          document.getElementById('hk').textContent = `${n.dataset.topic}, ${n.dataset.stage}`;
          document.getElementById('ht').textContent = n.dataset.title;
          document.getElementById('hm').textContent = `${n.dataset.near} nearby. Click to open.`;
          const r = n.getBoundingClientRect(), p = map.getBoundingClientRect();
          let left = r.left - p.left + map.scrollLeft + 16, top = r.top - p.top + map.scrollTop - 12;
          if (left + 270 > map.clientWidth + map.scrollLeft) left = r.left - p.left + map.scrollLeft - 276;
          hover.style.left = `${left}px`; hover.style.top = `${Math.max(8, top)}px`; hover.dataset.open = 'true';
        });
        n.addEventListener('mouseleave', () => { hover.dataset.open = 'false'; });
      });
      labels.forEach((l) => l.addEventListener('click', (e) => { e.preventDefault(); if (l.classList.contains('lit')) unlight(); else lightTopic(l.dataset.topic); }));
      document.querySelectorAll('.map-key').forEach((k) => k.addEventListener('click', (e) => { e.preventDefault(); lightTopic(k.dataset.topic); map.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }));
      clear.addEventListener('click', (e) => { e.preventDefault(); unlight(); });
      const q = new URLSearchParams(location.search);
      if (q.get('t')) lightThought(q.get('t')); else if (q.get('topic')) lightTopic(q.get('topic'));
    }
  </script>
</Garden>
