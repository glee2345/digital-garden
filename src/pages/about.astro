---
// About: the why (from the sheet's settings tab) and how the site was made.
import Garden from '../layouts/Garden.astro';
import { loadGarden, fmtDate } from '../lib/garden.js';
const g = loadGarden();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paras = String(g.site.about || '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<Garden current="about" title="about" description="What this garden is and how it was made.">
  <div class="prose">
    <h1>about this garden</h1>
    {paras.map((p) => <p set:html={p.replace(/\n/g, '<br>')} />)}
    <p class="stat">{`${g.stats.thoughts} thoughts, ${g.stats.topics} topics, ${g.stats.connections} connections${g.stats.firstPlanted ? `, planted since ${fmtDate(g.stats.firstPlanted, { year: true })}` : ''}`}</p>
  </div>

  <div class="prose how">
    <h2>how this site was made</h2>
    <p>I don't code. I type thoughts into a Google Sheet and the site takes care of the rest.</p>
    <ul class="tldr">
      <li><strong>Writing.</strong> One column in a Google Sheet. I paste in a sentence, some notes, a link, or drop a photo in the folder next to it. No titles or tags.</li>
      <li><strong>Filing.</strong> Every hour a script in the sheet checks for anything new and has an AI model (Gemini) write a title, put it under a topic, find related thoughts, and describe photos. Topics show up on their own as things pile up. If it gets something wrong I fix it in the sheet.</li>
      <li><strong>Growing.</strong> New thoughts are seedlings. They become growing once they connect to other thoughts or I edit them, and evergreen when I mark them.</li>
      <li><strong>Publishing.</strong> The script sends everything to GitHub, which rebuilds the site. It's all static pages, so hosting is free.</li>
      <li><strong>The bouquet.</strong> Drawn in text characters every time the home page loads. Each topic is a stem, each thought is a flower, and small topics hang down as amaranth. The <a href={`${base}/map/`}>map</a> shows the same thing laid flat.</li>
    </ul>
    <p>I designed and built it with Claude. The code is <a href="https://github.com/glee2345/digital-garden">on GitHub</a> with a README if you want to make your own. It runs on Astro, GitHub Pages, and Google Sheets. The font is Newsreader.</p>
  </div>

  <style>
    .prose + .prose { margin-top: 8px; padding-top: 32px; border-top: 1px solid var(--line); }
    .prose h2 { margin: 0; font-family: var(--serif); font-weight: 300; font-size: 32px; line-height: 1.2; color: var(--ink); }
    .prose ul.tldr { margin: 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 10px; }
    .prose ul.tldr li { line-height: 1.55; }
    .prose ul.tldr strong { font-weight: 500; font-style: italic; color: var(--text); }
    .prose .stat { font-size: 16px; color: var(--muted); }
    .prose a { border-bottom: 1px solid #6E7A62; color: var(--text); }
  </style>
</Garden>
