---
// Home: a short welcome, the latest few thoughts, what's growing.
// The deeper story lives on /about/.
import Garden from '../layouts/Garden.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import Growing from '../components/Growing.astro';
import Field from '../components/Field.astro';
import { loadGarden } from '../lib/garden.js';
const g = loadGarden();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = g.stream.filter((t) => !t.filing).slice(0, 3);
---
<Garden current="home">
  <section class="intro">
    <h1 class="hello">{g.site.tagline}</h1>
    {g.site.welcome && <p class="lede">{g.site.welcome}</p>}
  </section>

  {g.topics.length > 0 && <Field g={g} />}
  <p class="foot-note" style="margin-top:-24px">Each stem is a topic and each flower a thought — a bud while it's a seedling, open once it's growing, in full bloom when it's evergreen. Drag to turn the bouquet; hover a flower to see it, click to read it. <a href={`${base}/stream/`}>Read the stream →</a> · <a href={`${base}/about/`}>What is this?</a></p>

  {latest.length > 0 && (
    <div class="home-row">
      <div class="latest">
        <h2 class="sec">Recently planted</h2>
        {latest.map((t) => <ThoughtCard t={t} />)}
        <a class="pager" href={`${base}/stream/`}>everything, newest first</a>
      </div>
      <div class="side" id="growing"><Growing g={g} /></div>
    </div>
  )}
</Garden>
