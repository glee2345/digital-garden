---
// Home: a short welcome, the latest few thoughts, what's growing.
// The deeper story lives on /about/.
import Garden from '../layouts/Garden.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import Growing from '../components/Growing.astro';
import { loadGarden } from '../lib/garden.js';
const g = loadGarden();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = g.stream.filter((t) => !t.filing).slice(0, 3);
---
<Garden current="home">
  <section class="intro">
    <h1 class="hello">{g.site.tagline}</h1>
    {g.site.welcome && <p class="lede">{g.site.welcome}</p>}
    <p style="display:flex;flex-wrap:wrap;gap:8px"><a class="btn" href={`${base}/stream/`}>read the stream →</a> <a class="btn" href={`${base}/roots/`}>see the roots →</a> <a class="btn" href={`${base}/about/`}>what is this? →</a></p>
  </section>

  {latest.length > 0 && (
    <div class="home-row">
      <div class="latest">
        <h2 class="sec">Recently planted</h2>
        {latest.map((t) => <ThoughtCard t={t} />)}
        <a class="pager" href={`${base}/stream/`}>everything, newest first</a>
      </div>
      <div class="side" id="growing"><Growing g={g} /></div>
    </div>
  )}
</Garden>
