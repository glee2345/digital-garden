---
// Home: the bouquet grows front and center, then spins to its side while
// the latest thoughts and what's growing fade in beside it. Dark page.
import Garden from '../layouts/Garden.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import Growing from '../components/Growing.astro';
import Field from '../components/Field.astro';
import { loadGarden } from '../lib/garden.js';
const g = loadGarden();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = g.stream.filter((t) => !t.filing).slice(0, 3);
---
<Garden current="home" dark={true}>
  <section class="intro" style="gap:12px">
    <h1 class="hello">{g.site.tagline}</h1>
    {g.site.welcome && <p class="lede">{g.site.welcome}</p>}
  </section>

  <div class="home-stage" id="stage">
    <div class="home-bouquet">
      {g.topics.length > 0 ? <Field g={g} /> : <p class="foot-note">Nothing planted yet.</p>}
      <p class="foot-note field-note">Each stem is a topic and each flower a thought: a bud while it's a seedling, open once it's growing, in full bloom when it's evergreen. The smallest topics are baby's breath. Drag to turn it. Hover a flower to see it, click to read it.</p>
    </div>
    <div class="home-side">
      <div class="latest">
        <h2 class="sec">recently planted</h2>
        {latest.map((t) => <ThoughtCard t={t} />)}
        <a class="pager" href={`${base}/stream/`}>everything, newest first</a>
      </div>
      <div class="side" id="growing"><Growing g={g} /></div>
      <p class="foot-note"><a href={`${base}/about/`}>What is this?</a></p>
    </div>
  </div>

  <script is:inline>
    // first visit this session: watch it grow, then settle; after that, start settled
    (function () {
      var stage = document.getElementById('stage'); if (!stage) return;
      var seen = false; try { seen = sessionStorage.getItem('garden-seen') === '1'; } catch (e) {}
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seen || reduce) { stage.classList.add('settled', 'instant'); window.__gardenStartSettled = true; return; }
      setTimeout(function () { stage.classList.add('settled'); try { sessionStorage.setItem('garden-seen', '1'); } catch (e) {} }, 7600);
    })();
  </script>
</Garden>
