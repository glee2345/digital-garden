---
// Home: the bouquet grows front and center, then spins to its side while
// the latest thoughts and what's growing fade in beside it. Dark page.
import Garden from '../layouts/Garden.astro';
import Growing from '../components/Growing.astro';
import Field from '../components/Field.astro';
import { loadGarden } from '../lib/garden.js';
const g = loadGarden();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Garden current="home" dark={true}>
  <section class="intro" style="gap:12px">
    <h1 class="hello">{g.site.tagline}</h1>
    {g.site.welcome && <p class="lede">{g.site.welcome}</p>}
  </section>

  <div class="home-stage" id="stage">
    <div class="home-bouquet">
      {g.topics.length > 0 ? <Field g={g} /> : <p class="foot-note">Nothing planted yet.</p>}
    </div>
    <div class="home-side">
      <div class="side" id="growing"><Growing g={g} /></div>
      <p class="foot-note"><a href={`${base}/about/`}>What is this?</a></p>
    </div>
  </div>

  <script is:inline>
    // the layout is settled from the start; the bouquet grows in place on the
    // first visit of a session and starts fully grown after that
    (function () {
      var stage = document.getElementById('stage'); if (!stage) return;
      stage.classList.add('settled', 'instant');
      var seen = false; try { seen = sessionStorage.getItem('garden-seen') === '1'; } catch (e) {}
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seen || reduce) window.__gardenStartSettled = true;
      else { try { sessionStorage.setItem('garden-seen', '1'); } catch (e) {} }
    })();
  </script>
</Garden>
