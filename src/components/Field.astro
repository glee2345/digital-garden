---
// The field on the home page: the map, as flowers. Stems are topics,
// blooms are thoughts. Drawn live by public/flowers.js.
const { g } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const v = Date.now().toString(36); // cache-buster: a new build is a new file to the browser
const MAX_STEMS = 12;
const byConnections = (a, b) => (b.nearbyThoughts.length + b.mentionedBy.length) - (a.nearbyThoughts.length + a.mentionedBy.length) || (b.planted || '').localeCompare(a.planted || '');
const payload = {
  topics: g.topics.slice(0, MAX_STEMS).map((tp) => ({
    name: tp.name, url: tp.url, count: tp.count, isNew: tp.isNew, color: tp.color,
    thoughts: [...tp.thoughts].sort(byConnections).slice(0, 4).map((t) => ({ id: t.id, title: t.title, url: t.url, stage: t.stage, kind: t.kind, near: t.nearbyThoughts.length })),
  })),
  // everything not shown as a flower still thickens the baby's breath
  loose: g.thoughts.filter((t) => !t.topic && !t.filing).slice(0, 12).map((t) => ({ id: t.id, title: t.title, url: t.url })),
  extra: Math.max(0, g.stats.thoughts - g.topics.slice(0, MAX_STEMS).reduce((n, tp) => n + Math.min(4, tp.count), 0)),
  firstVisitKey: 'garden-seen',
};
---
<div class="field" id="field" tabindex="0" data-garden={JSON.stringify(payload)} aria-label="The garden as a bouquet: each stem is a topic, each flower a thought you can open. Drag or use the arrow keys to turn it.">
  <canvas aria-hidden="true"></canvas>
  <div class="hits"></div>
  <div class="tags" aria-hidden="true"></div>
  <span class="hint" aria-hidden="true">Drag to turn it.<br>Hover a flower to see it,<br>click to read it.</span>
  <div class="hovercard" data-open="false" aria-hidden="true"><span class="k"></span><span class="t"></span><span class="m"></span></div>
  <button type="button" class="replay" aria-label="Grow again">↻</button>
</div>
<script src={`${base}/flowers.js?v=${v}`} is:inline defer></script>
