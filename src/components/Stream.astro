---
// The stream: headline, topic chips, (optional) filter bar, feed + board.
import ThoughtCard from './ThoughtCard.astro';
import Growing from './Growing.astro';
const { g, topic = null, page = 1, perPage = 20 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = topic ? topic.thoughts : g.stream;
const pages = Math.max(1, Math.ceil(all.length / perPage));
const items = all.slice((page - 1) * perPage, page * perPage);
const shown = g.topics.slice(0, 7);
const hidden = g.topics.length - shown.length;
const nextUrl = topic ? `${topic.url}page/${page + 1}/` : `${base}/stream/page/${page + 1}/`;
---
<section style="display:flex;flex-direction:column;gap:22px">
  <h1 class="hello">{topic ? topic.name : 'the stream'}</h1>
  <div class="chips-scroll">
    <div class="chips">
      <a class:list={['chip', { on: !topic }]} href={`${base}/stream/`}>everything</a>
      {shown.map((tp) => (
        <a class:list={['chip', { on: topic?.name === tp.name, new: tp.isNew && topic?.name !== tp.name }]} href={topic?.name === tp.name ? `${base}/stream/` : tp.url}>
          {tp.name} <span class="n">{tp.isNew && topic?.name !== tp.name ? 'new' : tp.count}</span>
          {topic?.name === tp.name && <span class="x" aria-hidden="true">×</span>}
        </a>
      ))}
      {topic && !shown.includes(topic) && (
        <a class="chip on" href={`${base}/stream/`}>{topic.name} <span class="n">{topic.count}</span> <span class="x" aria-hidden="true">×</span></a>
      )}
      {hidden > 0 && <button type="button" class="chip more" data-open-topics>+ {hidden} more</button>}
      {g.topics.length > 0 && g.topics.length <= 3 && <span class="chips-hint">topics appear once a few thoughts cluster</span>}
    </div>
  </div>
  {topic && (
    <div class="filter-bar">
      <span>showing <strong>{topic.name}</strong>{`, ${topic.count} ${topic.count === 1 ? 'thought' : 'thoughts'}. `}<a href={`${base}/map/?topic=${topic.slug}`}>see it on the map</a></span>
      <a class="clear" href={`${base}/stream/`}>clear <span aria-hidden="true">×</span></a>
    </div>
  )}
</section>

{!topic && page === 1 && g.stats.thoughts > 0 && (
  <a class="board-line phone-only" href="#growing">
    <span><span class="t">What's growing</span>{g.growing.newRoots.length > 0 ? `: ${g.growing.newRoots.length === 1 ? 'a new root' : `${g.growing.newRoots.length} new roots`} this month` : `: ${g.stats.thoughts} thoughts, ${g.stats.topics} topics`}</span>
    
  </a>
)}
<div class="cols">
  <div class="feed">
    {items.map((t) => <ThoughtCard t={t} />)}
    {items.length === 0 && <p class="end">nothing here yet</p>}
    {page < pages ? (
      <a class="pager" href={nextUrl}>{topic ? `${all.length - page * perPage} more in ${topic.name}` : 'earlier'}</a>
    ) : (
      all.length > 0 && <p class="end">{`that's everything ${topic ? `in ${topic.name}` : 'so far'}: ${all.length} ${all.length === 1 ? 'thought' : 'thoughts'}`}</p>
    )}
  </div>
  <div class="side" id="growing">
    {g.stats.thoughts > 0 && (page === 1 || topic) ? <Growing g={g} topic={topic} /> : null}
  </div>
</div>
